package-as: WowEfficiency

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

# WowEfficiency/.pkgmeta
externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
    tag: latest

  Libs/CallbackHandler-1.0:
    url: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
    tag: latest

  Libs/Ace3/AceAddon-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
    tag: latest

  Libs/Ace3/AceEvent-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
    tag: latest

  Libs/Ace3/AceDB-3.0:
    # Latest release tag predates Forever's surname-aware character keys.
    url: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0@1424

  Libs/Ace3/AceConsole-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
    tag: latest

  Libs/Ace3/AceBucket-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceBucket-3.0
    tag: latest

  Libs/LibDataBroker-1.1:
    url: https://repos.wowace.com/wow/libdatabroker-1-1
    tag: latest

  Libs/LibDBIcon-1.0:
    url: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    tag: latest

ignore:
  - .claude
  - .reference-repos
  - .github
  - .vscode
  - CLAUDE.md
  - .env
  - .env.*
  - README.md
  - docs
  - Data/Quests/README.md
  - Context.md
  - Scripts
  - Libs/LibStub/tests
  # The external supplies the library directly; omit nested checkout distributions.
  - Libs/LibDBIcon-1.0/LibDBIcon-1.0
  - Libs/LibDBIcon-1.0/LibDataBroker-1.1
  - Libs/LibDBIcon-1.0/LibStub
  - Libs/LibDBIcon-1.0/CallbackHandler-1.0
  - Libs/LibDBIcon-1.0/embeds.xml
  - Libs/LibDBIcon-1.0/LibDBIcon-1.0.toc
